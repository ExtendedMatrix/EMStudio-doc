# EXAMPLE written for the EMStudio guide — not to be cited.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix v:    <https://w3id.org/extendedmatrix/profile/volto-esempio/vocab/punti-volto/> .

v: a skos:ConceptScheme ;
    dct:title "Points of the face (EXAMPLE)"@en , "Punti del volto (ESEMPIO)"@it ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" .

v:nasion a skos:Concept ; skos:inScheme v: ; skos:topConceptOf v: ;
    skos:prefLabel "nasion"@en , "nasion"@it ;
    skos:definition "The deepest point at the root of the nose."@en , "Il punto più profondo alla radice del naso."@it ;
    dct:source "Written for the example of the EMStudio guide." .

v:exocanthion a skos:Concept ; skos:inScheme v: ; skos:topConceptOf v: ;
    skos:prefLabel "outer corner of the eye"@en , "angolo esterno dell'occhio"@it ;
    skos:definition "Where the upper and lower eyelids meet, on the outside."@en , "Dove le palpebre si incontrano, verso l'esterno."@it ;
    dct:source "Written for the example of the EMStudio guide." .

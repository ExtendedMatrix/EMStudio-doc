msgstr ":kbd:`⌘S`"

msgid ":kbd:`Ctrl+S`"
msgstr ":kbd:`Ctrl+S`"

msgid "Save .em.json (⌘S)"
msgstr "Salva .em.json (⌘S)"

msgid "Save As…"
msgstr "Salva con nome…"

msgid ":kbd:`⇧⌘S`"
msgstr ":kbd:`⇧⌘S`"

msgid ":kbd:`Ctrl+Shift+S`"
msgstr ":kbd:`Ctrl+Shift+S`"

msgid "Save .em.json to a new file (⇧⌘S)"
msgstr "Salva .em.json in un file nuovo (⇧⌘S)"

msgid "Save all"
msgstr "Salva tutto"


msgstr "Apre la cartella di un progetto e l'em.json nella sua EM/"

msgid "Open Recent ▸"
msgstr "Apri recenti ▸"

msgid "The last files and rooms you opened. Filled when the sub-menu opens."
msgstr ""
"Gli ultimi file e stanze che hai aperto. Si riempie quando il sottomenu "
"si apre."

msgid "Save"
msgstr "Salva"

